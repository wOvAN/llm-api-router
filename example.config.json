{
  "servers": {
    "primary-openai": {
      "id": "primary-openai",
      "name": "Primary OpenAI",
      "url": "api.openai.com/v1",
      "proxy": "http://corp-proxy.example.com:3128",
      "proxy_enabled": true,
      "api_key": "sk-proj-...",
      "api_types": ["openai"]
    },
    "primary-anthropic": {
      "id": "primary-anthropic",
      "name": "Primary Anthropic",
      "url": "api.anthropic.com/v1",
      "api_key": "sk-ant-...",
      "api_types": ["anthropic"]
    },
    "local-llama": {
      "id": "local-llama",
      "name": "Local Llama (Multi-API)",
      "url": "localhost:8080",
      "openai_url": "localhost:8080/v1",
      "anthropic_url": "localhost:8080/anthropic/v1",
      "api_key": "",
      "api_types": ["openai", "anthropic"],
      "protocols": [{ "path": "/v1/chat/completions" }, { "path": "/v1/messages" }],
      "cooldown_time": 120,
      "tpm_limit": 100000,
      "rpm_limit": 60
    },
    "local-audio": {
      "id": "local-audio",
      "name": "Local Audio (TTS/STT)",
      "url": "localhost:8081",
      "api_key": "",
      "api_types": ["openai"]
    },
    "local-llama-2": {
      "id": "local-llama-2",
      "name": "Local Llama, second GPU",
      "url": "localhost:8082/v1",
      "api_key": "",
      "api_types": ["openai"]
    },
    "fallback": {
      "id": "fallback",
      "name": "Fallback Server",
      "url": "fallback.example.com/v1",
      "api_key": "sk-fallback-...",
      "api_types": ["openai"]
    }
  },
  "profiles": [
    {
      "id": "default",
      "name": "default",
      "rules": [
        {
          "incoming_models": ["qwen3-*"],
          "server_id": "local-llama",
          "balance": "round-robin",
          "fallbacks": [
            {
              "server_id": "local-llama-2",
              "weight": 3
            }
          ],
          "enabled": true
        },
        {
          "incoming_models": ["opus", "sonnet"],
          "target_model": "o3-mini",
          "server_id": "primary-openai",
          "num_retries": 2,
          "context_window": 200000,
          "fallbacks": [
            {
              "server_id": "fallback",
              "target_model": "gpt-4o-mini",
              "priority": 1,
              "context_window": 128000
            }
          ],
          "enabled": true
        },
        {
          "incoming_models": ["claude-opus"],
          "target_model": "claude-sonnet-4-6",
          "server_id": "primary-anthropic",
          "fallbacks": [
            {
              "server_id": "fallback",
              "priority": 1,
              "enabled": false
            }
          ],
          "enabled": true
        },
        {
          "incoming_models": ["haiku"],
          "target_model": "claude-haiku-4-5-20251001",
          "server_id": "primary-anthropic",
          "fallbacks": [],
          "enabled": false
        },
        {
          "incoming_models": ["systemone"],
          "target_model": "laya",
          "server_id": "local-llama",
          "fallbacks": [],
          "enabled": true
        },
        {
          "incoming_models": ["whisper", "tts"],
          "target_model": "qwen3-tts",
          "server_id": "local-audio",
          "num_retries": 1,
          "fallbacks": [],
          "enabled": false
        },
        {
          "incoming_models": ["auto"],
          "router": "jev",
          "jev": {
            "server_id": "local-llama",
            "model": "laya",
            "min_confidence": 0.3,
            "default_tier": 1,
            "timeout_ms": 1500,
            "cache_ttl": 60,
            "security": true,
            "candidates": [
              {
                "server_id": "local-llama",
                "target_model": "claude-haiku-4-5-20251001",
                "description": "small and fast; simple questions, formatting, short edits",
                "tier": 0,
                "context_window": 200000
              },
              {
                "server_id": "fallback",
                "target_model": "gpt-4o-mini",
                "description": "mid tier; everyday coding, summaries",
                "tier": 1
              },
              {
                "server_id": "primary-openai",
                "target_model": "o3-mini",
                "description": "strong reasoning; multi-file refactors, tricky bugs",
                "tier": 2
              }
            ]
          },
          "enabled": true
        }
      ]
    }
  ],
  "active_profile_id": "default",
  "settings": {
    "always_include_stream_usage": false,
    "trace": {
      "enabled": false,
      "seconds": 300,
      "models": [],
      "servers": []
    },
    "inbound": {
      "rps": 0,
      "burst": 0,
      "per_ip": true
    },
    "cors": {
      "enabled": false,
      "origins": ["http://localhost:3000"]
    },
    "routing": {
      "max_fallbacks": 5
    },
    "health": {
      "interval_seconds": 30,
      "timeout_seconds": 5,
      "path": "/v1/models"
    },
    "limiter": {
      "allowed_fails": 5,
      "cooldown_seconds": 300
    },
    "convert": {
      "max_tokens_default": 4096,
      "drop_params": false,
      "probe": false
    }
  }
}
